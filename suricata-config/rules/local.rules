# --- Onion Proxy Domains ---
alert http any any -> any any (msg:"DEEPGUARD: HTTP Request to .onion.to Proxy"; \
    flow:established,to_server; content:".onion.to"; http_host; isdataat:!1,relative; \
    classtype:policy-violation; sid:1000800; rev:1;)

alert http any any -> any any (msg:"DEEPGUARD: HTTP Request to .onion.city Proxy"; \
    flow:established,to_server; content:".onion.city"; http_host; isdataat:!1,relative; \
    classtype:policy-violation; sid:1000801; rev:1;)

alert http any any -> any any (msg:"DEEPGUARD: HTTP Request to .onion.cab Proxy"; \
    flow:established,to_server; content:".onion.cab"; http_host; isdataat:!1,relative; \
    classtype:policy-violation; sid:1000802; rev:1;)

alert http any any -> any any (msg:"DEEPGUARD: HTTP Request to .onion.direct Proxy"; \
    flow:established,to_server; content:".onion.direct"; http_host; isdataat:!1,relative; \
    classtype:policy-violation; sid:1000803; rev:1;)

