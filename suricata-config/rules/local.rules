alert http any any -> any any (msg:"DEEPGUARD: HTTP Request to Suspicious .tk Domain"; \
    flow:established,to_server; content:".tk"; http_host; isdataat:!1,relative; \
    classtype:bad-unknown; sid:1000805; rev:1;)

alert http any any -> any any (msg:"DEEPGUARD: HTTP Request to Suspicious .ml Domain"; \
    flow:established,to_server; content:".ml"; http_host; isdataat:!1,relative; \
    classtype:bad-unknown; sid:1000806; rev:1;)

alert http any any -> any any (msg:"DEEPGUARD: HTTP Request to Suspicious .ga Domain"; \
    flow:established,to_server; content:".ga"; http_host; isdataat:!1,relative; \
    classtype:bad-unknown; sid:1000807; rev:1;)

alert http any any -> any any (msg:"DEEPGUARD: HTTP Request to Suspicious .cf Domain"; \
    flow:established,to_server; content:".cf"; http_host; isdataat:!1,relative; \
    classtype:bad-unknown; sid:1000808; rev:1;)

# --- DNS to Suspicious TLDs ---
alert udp any any -> any 53 (msg:"DEEPGUARD: DNS Query to .onion Domain"; \
    content:"|05|onion|00|"; nocase; \
    classtype:policy-violation; sid:1000809; rev:1;)

alert udp any any -> any 53 (msg:"DEEPGUARD: DNS Query to .to Domain"; \
    content:"|02|to|00|"; nocase; \
    classtype:bad-unknown; sid:1000810; rev:1;)

# --- TLS to Suspicious Onion Proxy ---
alert tls any any -> any any (msg:"DEEPGUARD: TLS SNI to Onion Proxy"; \
    tls.sni; content:".onion."; \
    classtype:policy-violation; sid:1000811; rev:1;)

# --- HTTP on Non-Standard Port (application layer) ---
alert http any any -> any ![80,443,8080,8443,5000] (msg:"DEEPGUARD: HTTP on Non-Standard Port"; \
    flow:to_server,established; \
    threshold:type limit, track by_src, count 1, seconds 300; \
    classtype:non-standard-protocol; sid:1000812; rev:1;)


# ═══════════════════════════════════════════════════════════════════════════════
# 10. EXPLOIT DETECTION
# ═══════════════════════════════════════════════════════════════════════════════

# --- NOP Sled / Shellcode ---
alert tcp any any -> $HOME_NET any (msg:"DEEPGUARD: Possible Shellcode — NOP Sled Detected"; \
    content:"|90 90 90 90 90 90 90 90|"; \
    classtype:shellcode-detect; sid:1000900; rev:1;)

# --- x86 Shellcode Pattern ---
alert tcp any any -> $HOME_NET 80 (msg:"DEEPGUARD: Possible x86 Shellcode in HTTP"; \
    flow:to_server,established; content:"|eb|"; content:"|5e|"; within:50; \
    classtype:shellcode-detect; sid:1000901; rev:1;)

# --- EternalBlue (MS17-010) SMB Exploit ---
alert tcp any any -> $HOME_NET 445 (msg:"DEEPGUARD: SMB EternalBlue Exploit Attempt — MS17-010"; \
    flow:to_server,established; \
    content:"|ff|SMB|73 00 00 00|"; offset:4; depth:9; \
    content:"|09 00|"; distance:52; within:2; \
    classtype:exploit-kit; sid:1000902; rev:1;)

# --- Apache Struts RCE ---
alert http any any -> $HOME_NET any (msg:"DEEPGUARD: Apache Struts RCE — Content-Type OGNL Injection"; \
    flow:established,to_server; content:"multipart/form-data"; http_header; \
    content:"%{"; http_header; \
    classtype:exploit-kit; sid:1000903; rev:1;)

# --- Spring4Shell (CVE-2022-22965) ---
alert http any any -> $HOME_NET any (msg:"DEEPGUARD: Spring4Shell — Class Loader Manipulation"; \
    flow:established,to_server; content:"class.module.classLoader"; nocase; http_uri; \
    classtype:exploit-kit; sid:1000904; rev:1;)

# --- NTP Amplification DDoS ---
alert udp any any -> $HOME_NET 123 (msg:"DEEPGUARD: NTP Amplification DDoS — monlist Request"; \
    content:"|17 00 03 2a|"; offset:0; depth:4; \
    classtype:attempted-dos; sid:1000905; rev:1;)

# --- DNS Amplification DDoS ---
alert udp any any -> $HOME_NET 53 (msg:"DEEPGUARD: DNS Amplification — ANY Query Flood"; \
    content:"|00 ff|"; \
    threshold:type both, track by_src, count 20, seconds 10; \
    classtype:attempted-dos; sid:1000906; rev:1;)

# --- SSDP Amplification ---
alert udp any any -> $HOME_NET 1900 (msg:"DEEPGUARD: SSDP Amplification — M-SEARCH Flood"; \
    content:"M-SEARCH"; nocase; \
    threshold:type both, track by_src, count 20, seconds 10; \
    classtype:attempted-dos; sid:1000907; rev:1;)


# ═══════════════════════════════════════════════════════════════════════════════
# 11. CREDENTIAL THEFT & AUTH ANOMALIES
# ═══════════════════════════════════════════════════════════════════════════════

# --- NTLM Authentication over HTTP (relay risk) ---
alert http any any -> $HOME_NET any (msg:"DEEPGUARD: NTLM Authentication via HTTP — Relay Risk"; \
    flow:established,to_server; content:"NTLMSSP"; http_header; \
    classtype:credential-theft; sid:1001000; rev:1;)

# --- Kerberos AS-REQ for Service Account (Kerberoasting) ---
alert tcp $HOME_NET any -> $HOME_NET 88 (msg:"DEEPGUARD: Kerberos AS-REQ Burst — Possible Kerberoasting"; \
    flow:to_server,established; \
    threshold:type both, track by_src, count 15, seconds 30; \
    classtype:credential-theft; sid:1001001; rev:1;)

# --- LDAP Bind Flood (credential spray) ---
alert tcp any any -> $HOME_NET 389 (msg:"DEEPGUARD: LDAP Bind Flood — Credential Spray Attempt"; \
    flow:to_server,established; \
    threshold:type both, track by_src, count 20, seconds 60; \
    classtype:credential-theft; sid:1001002; rev:1;)

# --- SMB NTLM Negotiate (pass-the-hash indicator) ---
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"DEEPGUARD: SMB NTLM Auth to Multiple Hosts — Pass-the-Hash"; \
    flow:to_server,established; content:"NTLMSSP"; \
    threshold:type both, track by_src, count 5, seconds 120; \
    classtype:credential-theft; sid:1001003; rev:1;)

# --- HTTP Cleartext Credentials ---
alert http any any -> any any (msg:"DEEPGUARD: HTTP Basic Auth over Cleartext — Credential Exposure"; \
    flow:established,to_server; content:"Authorization|3a| Basic"; nocase; http_header; \
    threshold:type limit, track by_src, count 1, seconds 300; \
    classtype:credential-theft; sid:1001004; rev:1;)

# --- Default Credentials (admin/admin) ---
alert http any any -> $HOME_NET any (msg:"DEEPGUARD: Default Credentials Attempt — admin/admin"; \
    flow:established,to_server; content:"admin"; http_client_body; content:"admin"; http_client_body; \
    classtype:default-login-attempt; sid:1001005; rev:1;)

# --- SNMP Default Community String ---
alert udp any any -> $HOME_NET 161 (msg:"DEEPGUARD: SNMP Default Community — public"; \
    content:"public"; nocase; \
    classtype:default-login-attempt; sid:1001006; rev:1;)


