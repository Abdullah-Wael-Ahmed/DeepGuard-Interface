# 8. LATERAL MOVEMENT
# ═══════════════════════════════════════════════════════════════════════════════

# --- SMB Admin Share Access (C$, ADMIN$) ---
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"DEEPGUARD: SMB Admin Share Access — C$"; \
    flow:to_server,established; content:"|00|C|00|$"; \
    classtype:attempted-admin; sid:1000700; rev:1;)

alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"DEEPGUARD: SMB Admin Share Access — ADMIN$"; \
    flow:to_server,established; content:"|00|A|00|D|00|M|00|I|00|N|00|$"; \
    classtype:attempted-admin; sid:1000701; rev:1;)

# --- SMB IPC$ Access (enumeration / PsExec staging) ---
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"DEEPGUARD: SMB IPC$ Access — Possible Enumeration"; \
    flow:to_server,established; content:"|00|I|00|P|00|C|00|$"; \
    threshold:type both, track by_src, count 5, seconds 60; \
    classtype:attempted-recon; sid:1000702; rev:1;)

# --- PsExec Service Binary ---
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"DEEPGUARD: PsExec — PSEXESVC Binary Transfer"; \
    flow:to_server,established; content:"PSEXESVC"; nocase; \
    classtype:attempted-admin; sid:1000703; rev:1;)

# --- Internal RDP to Multiple Hosts ---
alert tcp $HOME_NET any -> $HOME_NET 3389 (msg:"DEEPGUARD: Internal RDP Sweep — Lateral Movement"; \
    flow:to_server; flags:S,12; \
    threshold:type both, track by_src, count 5, seconds 120; \
    classtype:attempted-admin; sid:1000704; rev:1;)

# --- WinRM Remote Execution ---
alert tcp $HOME_NET any -> $HOME_NET 5985 (msg:"DEEPGUARD: WinRM HTTP Connection — Possible Remote Execution"; \
    flow:to_server,established; \
    classtype:attempted-admin; sid:1000705; rev:1;)

alert tcp $HOME_NET any -> $HOME_NET 5986 (msg:"DEEPGUARD: WinRM HTTPS Connection — Possible Remote Execution"; \
    flow:to_server,established; \
    classtype:attempted-admin; sid:1000706; rev:1;)

# --- Internal SSH Sweep ---
alert tcp $HOME_NET any -> $HOME_NET 22 (msg:"DEEPGUARD: Internal SSH Sweep — Lateral Movement"; \
    flow:to_server; flags:S,12; \
    threshold:type both, track by_src, count 5, seconds 120; \
    classtype:attempted-admin; sid:1000707; rev:1;)

# --- DCOM/WMI Remote Execution ---
alert tcp $HOME_NET any -> $HOME_NET 135 (msg:"DEEPGUARD: DCOM/WMI — Remote Execution via RPC"; \
